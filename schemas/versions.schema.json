{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "versions.yml",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["service", "version", "status", "verified"],
    "properties": {
      "service": { "type": "string" },
      "version": { "type": "string", "minLength": 1 },
      "status": { "enum": ["recommended", "supported", "deprecated", "eol", "experimental"] },
      "end_of_support": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "release_notes": { "type": "string", "format": "uri" },
      "breaking_changes": { "type": "boolean" },
      "verified": { "type": "boolean" }
    }
  }
}
