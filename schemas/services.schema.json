{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "services.yml",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "theme", "summary", "audience", "use_when", "owner", "validated", "updated", "links", "prerequisites"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "theme": { "enum": ["identite", "interop", "securite", "donnees", "tests"] },
      "summary": { "type": "string", "minLength": 1 },
      "audience": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["editeur", "integrateur", "developpeur"] }
      },
      "use_when": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "validated": { "type": "boolean" },
      "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentation"],
        "properties": {
          "documentation": { "type": "string", "format": "uri" },
          "specification": { "type": "string", "format": "uri" },
          "sandbox": { "type": "string", "format": "uri" },
          "test_data": { "type": "string", "format": "uri" },
          "source_code": { "type": "string", "format": "uri" },
          "support": { "type": "string", "format": "uri" },
          "status_page": { "type": "string", "format": "uri" },
          "roadmap": { "type": "string", "format": "uri" }
        }
      },
      "sandbox": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "access", "limits"],
        "properties": {
          "summary": { "type": "string" },
          "access": { "type": "string" },
          "limits": { "type": "string" }
        }
      },
      "prerequisites": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security", "compliance", "referencing"],
        "properties": {
          "security": { "type": "string" },
          "compliance": { "type": "string" },
          "referencing": { "type": "string" }
        }
      },
      "examples": {
        "type": "array",
        "uniqueItems": true,
        "items": { "enum": ["java", "javascript", "python", "curl"] }
      },
      "related": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      }
    }
  }
}
